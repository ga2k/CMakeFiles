{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28
  },
  "configurePresets": [
    {
      "name": "Debug",
      "hidden": true,
      "description": "Create a debug build",
      "cacheVariables": {
        "buildType": "Debug",
        "linkType": "Shared"
      },
      "environment": {
        "buildType": "Debug",
        "linkType": "Shared",
        "buildPath": "/debug"
      }
    },
    {
      "name": "Release",
      "hidden": true,
      "description": "Create a release build",
      "cacheVariables": {
        "buildType": "Release",
        "linkType": "Shared"
      },
      "environment": {
        "buildType": "Release",
        "linkType": "Shared",
        "buildPath": "/release"
      }
    },
    {
      "name": "Windows",
      "hidden": true,
      "description": "Windows build for x64 processors using Ninja (for C++20 modules)",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "$env{PROCESSOR_ARCHITECTURE}",
            "rhs": "AMD64"
          }
        ]
      },
      "generator": "Ninja",
      "environment": {
        "hostType": "Windows",
        "archType": "x64",
        "CMAKE_NINJA_FLAGS": "-k 0"
      },
      "cacheVariables": {
        "BUILD_WX_FROM_SOURCE": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "C:/Program Files/LLVM/bin/clang-scan-deps.exe",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_LINKER": "C:/Program Files/LLVM/bin/ld.lld.exe",
        "CMAKE_RC_COMPILER": "C:/Program Files/LLVM/bin/llvm-rc.exe",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "OPENSSL_ROOT_DIR": "C:/Program Files/OpenSSL-Win64"
      }
    },
    {
      "name": "Darwin",
      "hidden": true,
      "description": "Darwin build for arm64 processors",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          },
          {
            "type": "equals",
            "lhs": "$env{CPU}",
            "rhs": "arm64"
          }
        ]
      },
      "generator": "Ninja",
      "environment": {
        "hostType": "Darwin",
        "archType": "arm64",
        "CMAKE_NINJA_FLAGS": "-k 0"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "CMAKE_SHARED_LINKER_FLAGS": "-L/opt/homebrew/Cellar/llvm/22.1.5/lib/c++ -Wl,-rpath,/opt/homebrew/Cellar/llvm/22.1.5/lib/c++ /opt/homebrew/Cellar/llvm/22.1.5/lib/c++/libc++.1.0.dylib /opt/homebrew/Cellar/llvm/22.1.5/lib/c++/libc++abi.dylib",
        "CMAKE_EXE_LINKER_FLAGS":    "-L/opt/homebrew/Cellar/llvm/22.1.5/lib/c++ -Wl,-rpath,/opt/homebrew/Cellar/llvm/22.1.5/lib/c++ /opt/homebrew/Cellar/llvm/22.1.5/lib/c++/libc++.1.0.dylib /opt/homebrew/Cellar/llvm/22.1.5/lib/c++/libc++abi.dylib",
        "BUILD_WX_FROM_SOURCE": "ON"
      }
    },
    {
      "name": "Linux",
      "hidden": true,
      "description": "Linux build for x64 processors",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "$env{CPU}",
            "rhs": "x86_64"
          }
        ]
      },
      "generator": "Ninja",
      "environment": {
        "hostType": "Linux",
        "archType": "x64",
        "CMAKE_NINJA_FLAGS": "-k 0"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "BUILD_WX_FROM_SOURCE": "ON"
      }
    },
    {
      "name": "Windows Debug",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}",
        "SSL_EAY": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MDd/libssl.lib",
        "LIB_EAY": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MDd/libcrypto.lib"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Windows",
        "Debug"
      ]
    },
    {
      "name": "Windows Release",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}",
        "SSL_EAY": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MD/libssl.lib",
        "LIB_EAY": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MD/libcrypto.lib"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Windows",
        "Release"
      ]
    },
    {
      "name": "Darwin Debug",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Darwin",
        "Debug"
      ]
    },
    {
      "name": "Darwin Release",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Darwin",
        "Release"
      ]
    },
    {
      "name": "Linux Debug",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Linux",
        "Debug"
      ]
    },
    {
      "name": "Linux Release",
      "cacheVariables": {
        "stemPath": "$env{hostPath}$env{buildPath}$env{linkPath}"
      },
      "binaryDir": "build$env{hostPath}$env{buildPath}$env{linkPath}",
      "inherits": [
        "Linux",
        "Release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "Windows Debug",
      "configurePreset": "Windows Debug"
    },
    {
      "name": "Windows Release",
      "configurePreset": "Windows Release"
    },
    {
      "name": "Darwin Debug",
      "configurePreset": "Darwin Debug"
    },
    {
      "name": "Darwin Release",
      "configurePreset": "Darwin Release"
    },
    {
      "name": "Linux Debug",
      "configurePreset": "Linux Debug"
    },
    {
      "name": "Linux Release",
      "configurePreset": "Linux Release"
    }
  ]
}
